# Copy to .env and fill in. Leave Firebase keys empty to use the offline local backend.

# Firebase (Project settings > Your apps > Web app config)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_REGION=us-central1

# RevenueCat public SDK keys (Project > API keys)
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# AdMob ad unit IDs (empty = Google test ads)
EXPO_PUBLIC_AD_BANNER_IOS=
EXPO_PUBLIC_AD_BANNER_ANDROID=
EXPO_PUBLIC_AD_INTERSTITIAL_IOS=
EXPO_PUBLIC_AD_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_AD_REWARDED_IOS=
EXPO_PUBLIC_AD_REWARDED_ANDROID=

# AdMob app IDs (build time; empty = Google test app IDs)
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=

# Links
EXPO_PUBLIC_LINK_BASE=https://dailyduel.app
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# EAS (set by `eas init`)
EAS_PROJECT_ID=
EXPO_OWNER=
